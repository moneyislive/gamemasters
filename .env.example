# Clave de API de Anthropic. Si se deja vacía, la plataforma funciona en MODO DEMO
# (el agente y la generación de tramas usan plantillas locales).
ANTHROPIC_API_KEY=

# Modelo por defecto del agente de CLUEDO. Configurable también desde la UI.
# Opciones: claude-fable-5 | claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
ANTHROPIC_MODEL=claude-fable-5

# Cadena de conexión de MongoDB Atlas. Si se deja vacía, se usa almacenamiento
# local en fichero JSON (server/data/db.json) — ideal para desarrollo.
# Ejemplo:
# MONGODB_URI=mongodb+srv://usuario:contrasena@cluster0.ab1cd.mongodb.net/?retryWrites=true&w=majority
#
# ELIGE UNA REGIÓN EUROPEA al crear el clúster (Fráncfort, Irlanda, París). Aquí
# se guardan nombres, correos y las notas privadas de personas reales, y el
# valor por defecto de un clúster gratuito de Atlas es Virginia (us-east-1):
# sacar esos datos de la UE sin querer, y sin decírselo a nadie, es justo lo que
# no se puede hacer. Es una decisión que solo se toma UNA vez, al crearlo: la
# región no se cambia después.
#
# Ojo: si MONGODB_URI está definida y el clúster no responde, en producción el
# servidor se NIEGA a arrancar. Es a propósito — arrancar con el fichero local
# mostraría la base de datos vacía y acabarías rehaciendo partidas que existen.
MONGODB_URI=

# Base de datos dentro del clúster. Si se omite, se usa la que indique la URI
# y, si la URI no indica ninguna, «gamemasters».
MONGODB_DB=

# Puerto del servidor API
PORT=5174

# ---------------------------------------------------------------------------
# Solo para PUBLICAR en internet (en local no hacen falta)
# ---------------------------------------------------------------------------

# Secreto con el que se firman las credenciales de los móviles y la sesión del
# taller. En producción es OBLIGATORIO: sin él el servidor se niega a arrancar,
# y con razón, porque cualquiera podría fabricarse la credencial de otro
# jugador y leerle el dosier —es decir, saber quién es el culpable—.
#
# En local, si se deja vacío, se genera uno solo y se guarda en
# server/data/secreto-de-firma (que git ignora).
#
# Genera el tuyo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Cambiarlo echa a todo el mundo: hay que volver a repartir los códigos.
PLAYER_TOKEN_SECRET=

# Contraseña única de acceso al TALLER. Si se define, nadie entra sin ella y así
# nadie gasta tu clave de API. Si se deja vacía, la aplicación queda abierta:
# por eso, con NODE_ENV=production, el servidor se niega a arrancar sin ella.
#
# Ya NO se usa como clave criptográfica —esa es PLAYER_TOKEN_SECRET—, así que
# puede ser una contraseña normal y corriente.
APP_PASSWORD=

# Carpeta donde se guardan las fotos subidas. En producción debe apuntar a un
# disco PERSISTENTE (en Render: /var/data/uploads); si no, se borran en cada
# despliegue. En local se deja vacío y usa server/uploads.
UPLOADS_DIR=

# Carpeta del cliente ya compilado. Normalmente no hace falta: el servidor
# encuentra client/dist por su cuenta.
CLIENT_DIR=

# Carpeta de la app web ya exportada. Igual que la de arriba: normalmente no
# hace falta, porque se busca en `../app/dist` y en `app/dist`. Ponerla importa
# cuando el proceso NO arranca desde donde se espera, porque si no el fallo es
# «esa página no existe» sin decir dónde la buscaba.
APP_WEB_DIR=

# ---------------------------------------------------------------------------
# Generacion 3D (opcional: sin esto, la app funciona pero no genera)
# ---------------------------------------------------------------------------

# Tripo (tripo3d.ai -> API): convierte la imagen que sube el usuario en su
# avatar 3D con texturas. Elegido sobre Hunyuan3D porque trae auto-rigging y
# animaciones en la misma API, que es la fase siguiente.
TRIPO_API_KEY=

# Google AI Studio (aistudio.google.com): genera los fondos de sala en 4K con
# la familia de modelos de imagen de Gemini («nano banana»).
GEMINI_API_KEY=
# El modelo concreto caduca rapido; este es el mando para cambiarlo sin tocar
# codigo. Ejemplos: gemini-2.5-flash-image | gemini-3-pro-image-preview
GEMINI_IMAGE_MODEL=

# ---------------------------------------------------------------------------
# Iniciar sesion con Google y Apple (opcional)
# ---------------------------------------------------------------------------

# Identificadores de cliente ADMITIDOS, separados por comas. Es un CONJUNTO, no
# uno solo, y es el error numero uno de estas integraciones:
#   Google: en movil nativo el id_token viene firmado con el cliente WEB (el de
#           la plataforma va en `azp`), asi que hace falta al menos ese.
#   Apple:  iOS nativo firma con el BUNDLE ID (com.gamemasters.jugar) y web y
#           Android con el Services ID. Los dos van aqui.
# Un client id NO es secreto: puede vivir en el repositorio sin problema.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Quien puede abrir el TALLER entrando con su cuenta de proveedor. Correos
# separados por comas, y se comparan solo contra correos VERIFICADOS. Vacio =
# ninguna cuenta de proveedor abre el taller (la contrasena de la casa sigue
# funcionando).
GM_ADMITIDOS=

# ---------------------------------------------------------------------------
# EL DOMINIO Y EL DESPLIEGUE
# ---------------------------------------------------------------------------

# Modo de ejecución. SIN ESTA LÍNEA NO HAY PRODUCCIÓN, por mucho que el dominio
# sea público, y son seis comportamientos los que cuelgan de ella:
#
#   · HOST cae a 0.0.0.0 y el puerto queda expuesto en la IP pública. Con
#     `trust proxy` activo, quien llegue directo puede falsificar el protocolo y
#     la IP de origen, saltándose nginx entero.
#   · El taller se abre solo si falta APP_PASSWORD, en vez de cerrarse.
#   · Las costuras de prueba de OIDC dejan de estar prohibidas.
#   · Si Atlas parpadea, el servidor cae al fichero JSON local en vez de
#     negarse a arrancar: el taller aparece VACÍO y se rehacen partidas que
#     existen.
#
# Va también en la unidad de systemd, para que no dependa de este fichero.
NODE_ENV=production

# El origen público, tal y como se llega desde fuera. Sin barra final.
#
# Con él se fabrica la dirección de vuelta que se le da a Google, y Google exige
# que coincida CARÁCTER POR CARÁCTER con la registrada en su consola. Si se deja
# vacío en producción, el servidor se niega a arrancar: es preferible a que
# fallen todos los inicios de sesión a la vez sin motivo aparente.
#
# De aquí sale además el flag `secure` de las cookies. Atarlo a la petición
# significa que, el día que nginx se despiste con X-Forwarded-Proto, la sesión
# de noventa días viaja en claro sin que nada falle a la vista.
PUBLIC_ORIGIN=https://harkania.com

# En qué interfaz escucha el proceso. Por defecto 127.0.0.1 en producción (solo
# nginx llega) y 0.0.0.0 en el resto (el portátil hace de servidor de los
# móviles de la casa). Normalmente no hay que tocarla.
HOST=

# Identificador del equipo de Apple (10 caracteres, en el portal de desarrollo,
# arriba a la derecha). Sin él, /.well-known/apple-app-site-association responde
# 404 a propósito: un fichero de asociación con un hueco es PEOR que ninguno,
# porque Apple lo cachea durante días y la app queda desvinculada del dominio.
APPLE_TEAM_ID=

# Huella SHA-256 del certificado con el que se firma el binario PUBLICADO de
# Android — no el de desarrollo. Con EAS se saca con `eas credentials`. Se
# admiten varias separadas por comas, porque durante una rotación de clave
# conviven dos y quedarse con una rompe a quien no ha actualizado.
ANDROID_CERT_SHA256=

# ---------------------------------------------------------------------------
# QUIEN RESPONDE: aviso legal, terminos y politica de privacidad
# ---------------------------------------------------------------------------

# El NIF y el domicilio los exige el articulo 10 de la LSSI y los piden las dos
# tiendas para publicar. Mientras falten, el AVISO LEGAL lo dice en su propia
# cara («pendiente de completar») en vez de dejar un hueco en blanco o
# inventarse un dato: un aviso legal con datos falsos es peor que uno
# incompleto.
#
# La politica de privacidad NO se marca como incompleta por esto, y es
# deliberado: el RGPD le pide la identidad del responsable y una via de
# contacto, y las dos estan. Colgarle un defecto que no tiene alarmaria a quien
# la lee — que es, entre otros, quien revisa la app para la tienda.

# Nombre o razon social. Vacio: se usa el que la politica ya publica hoy.
LEGAL_RESPONSABLE=
# NIF o CIF.
LEGAL_NIF=
# Domicilio completo, tal y como debe aparecer publicado.
LEGAL_DIRECCION=
# Correo de contacto legal y de proteccion de datos. Vacio: el de la politica.
LEGAL_CORREO=
# Datos de inscripcion registral. SOLO para sociedades: vacio, la fila no
# aparece. Una persona fisica no esta inscrita en ningun registro, y marcarlo
# como pendiente anunciaria para siempre la falta de algo que no tiene por que
# existir.
LEGAL_REGISTRO=

# ---------------------------------------------------------------------------
# EL CORREO DE LAS INVITACIONES
# ---------------------------------------------------------------------------

# Como se mandan las invitaciones. Dos modos:
#
#   memoria  (por defecto)  No sale nada de la maquina: los envios se guardan en
#                           un array y se escriben por consola. Es lo que hay que
#                           usar en local, y lo que usan las comprobaciones.
#   ses                     Amazon SES por HTTPS, firmado a mano con SigV4
#                           (server/src/correo/ses.ts). Sin SDK de AWS: la unica
#                           operacion que hace falta es mandar un correo, y
#                           arrastrar decenas de paquetes para eso es superficie
#                           que hay que mantener al dia.
#
# Cualquier otro valor hace que el servidor se niegue a arrancar en vez de caer
# en silencio al modo memoria: creer que las invitaciones salen cuando no salen
# es peor que no tener correo, porque nadie lo descubre hasta que los invitados
# no aparecen.
CORREO_MODO=memoria

# El «De:». En SES tiene que ser una direccion o un dominio YA VERIFICADO en la
# consola; si no, SES rechaza el envio con un error que no menciona la
# verificacion. Ej.: veladas@harkania.com
CORREO_REMITENTE=

# Region de SES. Ojo: no todas las regiones tienen SES, y la cuenta empieza en
# «sandbox», donde solo se puede escribir a direcciones tambien verificadas.
# Para mandar a los invitados de verdad hay que pedir la salida del sandbox.
SES_REGION=eu-west-1
# Alternativa a la anterior: si SES_REGION esta vacia, se usa esta. Existe
# porque es la que ya trae el entorno cuando se despliega dentro de AWS.
AWS_REGION=

# Credenciales. En EC2 lo correcto es NO ponerlas: se le asigna a la instancia
# un rol de IAM con permiso ses:SendEmail y AWS las inyecta solas (y las rota).
# Estas variables son para desarrollo o para cuando no hay rol.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo con credenciales temporales. Si esta, viaja firmada en la peticion.
AWS_SESSION_TOKEN=

# A donde se manda de verdad. Vacio: https://email.<SES_REGION>.amazonaws.com
# Existe para que las comprobaciones puedan levantar un SES de mentira y
# verificar la firma sin una cuenta de AWS. En produccion tiene que ser HTTPS y
# el servidor lo exige: por ahi saldrian en claro el nombre y el correo de cada
# persona invitada.
SES_ENDPOINT=

# ---------------------------------------------------------------------------
# LA DESCARGA DE LA APP, mientras no haya tienda
# ---------------------------------------------------------------------------

# UNA SOLA VARIABLE, y por que. La version y la direccion se escribian a mano por
# separado, y acabaron discrepando: se publico la 1.0.2 y quedo la etiqueta vieja
# con el fichero nuevo —v1.0.1/harkania-1.0.2.apk— que da 404. La pagina se veia
# perfecta, anunciaba «Version 1.0.2», y el boton no bajaba nada. Dos campos que
# tienen que concordar y que nadie compara acaban discrepando siempre.
#
# Ahora basta con esta: la direccion se deduce como
#   https://github.com/<APK_REPO>/releases/download/v<version>/harkania-<version>.apk
#
# Vacia: /descargar dice que todavia no hay descarga, en vez de un boton muerto.
# Al arrancar, el servidor comprueba que ese enlace existe y lo grita en el
# registro si no — es un fallo invisible de otra forma.
APK_VERSION=

# El repositorio de las releases. Vacio: moneyislive/gamemasters
APK_REPO=

# Solo para saltarse el patron de arriba (fichero fuera de GitHub, u otro
# nombre). Si esta puesta, manda ella. Normalmente se deja vacia.
APK_URL=

# --- El freno de lo que cuesta dinero ---------------------------------------
# Tope diario por identidad, por familia. Generar una trama cuesta entre 0,48 y
# 0,82 euros MEDIDOS cada vez, y el chat del taller no tiene fondo: da hasta
# doce vueltas por turno reenviando la conversacion entera.
#
# Holgados a proposito: cortan un bucle, no racionan el producto. Un 0 quita el
# tope de esa familia. Ver `server/src/gasto/tope.ts`.
TOPE_DIARIO_TRAMAS=8
TOPE_DIARIO_CHARLA=250
TOPE_DIARIO_ESTUDIO=8
