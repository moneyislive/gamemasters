# Clave de API de Anthropic. Si se deja vacía, la plataforma funciona en MODO DEMO
# (el agente y la generación de tramas usan plantillas locales).
ANTHROPIC_API_KEY=

# Modelo por defecto del agente de CLUEDO. Configurable también desde la UI.
# Opciones: claude-fable-5 | claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
ANTHROPIC_MODEL=claude-fable-5

# Cadena de conexión de MongoDB Atlas. Si se deja vacía, se usa almacenamiento
# local en fichero JSON (server/data/db.json) — ideal para desarrollo.
# Ejemplo:
# MONGODB_URI=mongodb+srv://usuario:contrasena@cluster0.ab1cd.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Base de datos dentro del clúster. Si se omite, se usa la que indique la URI
# y, si la URI no indica ninguna, «gamemasters».
MONGODB_DB=

# Puerto del servidor API
PORT=5174

# ---------------------------------------------------------------------------
# Solo para PUBLICAR en internet (en local no hacen falta)
# ---------------------------------------------------------------------------

# Contraseña única de acceso. Si se define, nadie entra sin ella y así nadie
# gasta tu clave de API. Si se deja vacía, la aplicación queda abierta.
APP_PASSWORD=

# Carpeta donde se guardan las fotos subidas. En producción debe apuntar a un
# disco PERSISTENTE (en Render: /var/data/uploads); si no, se borran en cada
# despliegue. En local se deja vacío y usa server/uploads.
UPLOADS_DIR=

# Carpeta del cliente ya compilado. Normalmente no hace falta: el servidor
# encuentra client/dist por su cuenta.
CLIENT_DIR=
