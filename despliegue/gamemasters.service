# Unidad de systemd. Se copia a /etc/systemd/system/gamemasters.service
#
# Comprueba la ruta real de node antes de instalarla:  command -v node
# Si no es /usr/bin/node, corrige ExecStart. Con la ruta equivocada el servicio
# falla al arrancar con un «203/EXEC» que no dice qué falta.

[Unit]
Description=GameMasters — juegos de misterio en la vida real
Documentation=https://harkania.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gamemasters
Group=gamemasters
WorkingDirectory=/opt/gamemasters

# NODE_ENV va AQUÍ y no solo en el fichero de entorno, a propósito: de esta
# variable cuelgan seis comportamientos —entre ellos que el puerto no quede
# expuesto y que el servidor se niegue a caer al fichero JSON local si Atlas
# parpadea—, y un fichero de entorno se edita a mano y se puede quedar sin ella
# sin que nada avise.
Environment=NODE_ENV=production

# LAS MESAS DE LA SALA DE ARCADE, DENTRO DE LO QUE SE PUEDE ESCRIBIR.
#
# Sin esta línea se guardarían en `/opt/gamemasters/data/mesas`, o sea dentro de
# WorkingDirectory — y con `ProtectSystem=strict` de más abajo eso es de SOLO
# LECTURA: el fichero no se puede ni crear. El servidor arranca igual, las
# partidas se juegan igual y no queda ni una en el disco, así que el primer
# `systemctl restart` se lleva todas las que hubiera abiertas. Con «La Larga»
# —partidas de días— eso no es una molestia: es perder la partida.
#
# La carpeta cuelga de /var/lib/gamemasters, que es el único ReadWritePaths de
# esta unidad. Si algún día se añade otra ruta escribible, ésta puede moverse;
# lo que no puede es quedarse sin declarar.
Environment=MESAS_DIR=/var/lib/gamemasters/mesas

# Los secretos NO van en esta unidad: la leen todos los usuarios de la máquina
# (`systemctl cat`). Van en un fichero aparte, propiedad de root y en modo 600.
EnvironmentFile=/etc/gamemasters/entorno

# EL BINARIO ESTA EN `server/dist/`, NO EN `dist/`.
#
# Aqui ponia `dist/index.js`, y con `WorkingDirectory=/opt/gamemasters` eso
# apunta a un fichero que el build NO CREA NUNCA: `server/package.json` compila
# con `--outfile=dist/index.js` y lo hace desde `server/`, asi que el resultado
# es `/opt/gamemasters/server/dist/index.js`.
#
# El servicio no podia levantar en esta maquina, y el sintoma es del peor tipo:
# systemd dice «status=1/FAILURE» y el diario, «Cannot find module», sin
# nombrar ni el build ni la carpeta que falta.
#
# El WorkingDirectory se queda como esta A PROPOSITO: de el cuelgan la ruta por
# defecto de MESAS_DIR y las busquedas del taller y del cliente de escritorio,
# que son relativas a la raiz del repositorio y no a `server/`.
ExecStart=/usr/bin/node server/dist/index.js

Restart=always
RestartSec=5
# Si se cae cinco veces en un minuto, se para de intentarlo: reiniciar en bucle
# contra un Atlas caído solo llena el registro y calienta la máquina.
StartLimitBurst=5
StartLimitIntervalSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gamemasters

# Endurecimiento. El proceso solo necesita leer su código y escribir las fotos.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gamemasters
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
