{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "taller",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "client"
      ],
      "port": 5173
    },
    {
      "name": "movil",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web",
        "--prefix",
        "app"
      ],
      "port": 8081
    },
    {
      "name": "arcade",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web",
        "--prefix",
        "../GameMasters-arcade/app"
      ],
      "port": 8081
    },
    {
      "name": "sala",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "../GameMasters-arcade/server"
      ],
      "port": 5174
    },
    {
      "name": "veladas",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web",
        "--prefix",
        "../GameMasters-veladas/app"
      ],
      "port": 8082
    },
    {
      "name": "escritorio3d",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "escritorio"
      ],
      "port": 5175,
      "url": "http://localhost:5175"
    },
    {
      "name": "burgo-servidor",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set PORT=5231&& npm run dev -w server"
      ],
      "port": 5231,
      "autoPort": false
    },
    {
      "name": "burgo-escritorio",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set GM_API_URL=http://localhost:5231&& npm run dev -w escritorio -- --port 5232"
      ],
      "port": 5232,
      "url": "http://localhost:5232",
      "autoPort": false
    },
    {
      "name": "burgo-movil",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set EXPO_PUBLIC_API_URL=http://localhost:5231&& npm run web --prefix app -- --port 8091"
      ],
      "port": 8091,
      "url": "http://localhost:8091",
      "autoPort": false
    },
    {
      "name": "lindes-escritorio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "escritorio",
        "--",
        "--port",
        "5241"
      ],
      "port": 5241,
      "url": "http://localhost:5241",
      "autoPort": false
    }
  ]
}
