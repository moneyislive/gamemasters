    "verify:sin-ejes": "tsx scripts/verificar-juego-sin-ejes.ts",
    "verify:campana": "tsx scripts/verificar-campana.ts",
    "verify:credenciales": "tsx scripts/verificar-credenciales.ts",
    "verify:aguante": "tsx scripts/verificar-aguante.ts",
    "verify:borrado": "tsx scripts/verificar-borrado.ts",
    "verify:cuentas": "tsx scripts/verificar-cuentas.ts",
    "verify:duenas": "tsx scripts/verificar-duenas.ts",
    "verify:tokens": "tsx scripts/verificar-tokens.ts",
