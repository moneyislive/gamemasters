{
  "expo": {
    "name": "GameMasters",
    "slug": "harkania",
    "scheme": "harkania",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1710",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harkania.jugar",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:harkania.com",
        "webcredentials:harkania.com"
      ]
    },
    "android": {
      "package": "com.harkania.jugar",
      "adaptiveIcon": {
        "backgroundColor": "#0b1710",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "harkania.com",
              "pathPrefix": "/i"
            },
            {
              "scheme": "https",
              "host": "harkania.com",
              "pathPrefix": "/e"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Tu foto se usa solo para generar tu avatar 3D. No sale de tu servidor de juego salvo hacia el servicio de esculpido.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1710",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "4080bdc1-ce9e-4a03-ba90-b6a3fb2d14f3"
      }
    }
  }
}
