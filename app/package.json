{
  "name": "gamemasters-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "verify": "node src/comprobadores/verificar-app.mjs && node src/comprobadores/verificar-tema.mjs && node src/comprobadores/verificar-conexion.mjs",
    "verify:rutas": "node src/comprobadores/verificar-rutas.mjs",
    "build": "expo export --platform web --output-dir dist"
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@react-three/fiber": "^9.7.0",
    "expo": "~57.0.11",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.6",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-gl": "~57.0.2",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.9",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "meshoptimizer": "^1.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/three": "^0.185.4",
    "typescript": "~6.0.3"
  },
  "private": true
