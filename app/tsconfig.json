{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../shared/**/*.ts",
    "../escenas/embarcadero/**/*.ts",
    "../escenas/embarcadero/**/*.tsx",
    "../escenas/jsx-de-three.d.ts"
  ],
  "exclude": ["node_modules"]
}
